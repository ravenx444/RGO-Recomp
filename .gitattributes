* text=auto eol=lf
*.bat text eol=crlf
# RGO: cmd.exe misreads labels in LF-only batch files.
/rgo-rebuild.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.png binary
*.ico binary

*.ttf binary
# Preserve the upstream OFL license bytes, including original whitespace.
launcher/ui/fonts/*-OFL.txt -whitespace
